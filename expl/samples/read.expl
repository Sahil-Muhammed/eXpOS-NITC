

int main()
{
decl
    int temp, fd;
    string fileName, out;
enddecl
begin
	temp = exposcall("Read", -1, fileName);	
	fd = exposcall("Open", fileName);
	
	if (fd >= 0) then
		temp = exposcall("Read", temp, out);

		if (temp == 0) then	
			temp = exposcall("Write", -2, out);
		endif;

		temp = exposcall("Close", fd);
	else
		temp = exposcall("Write", -2, "Open failed");
	endif;
	return 0;
end
}


