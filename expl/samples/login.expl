int main()
{
decl
	int temp, a, temp1;
        string uname, pw;
enddecl
begin
	a=1;
	while(a == 1) do
		temp = exposcall("Write", -2, "---Enter Username---");
		temp = exposcall("Read", -1, uname);
		temp = exposcall("Write", -2, "---Enter Password---");
		temp = exposcall("Read", -1, pw);

		temp = exposcall("Login", uname, pw);
		if (temp == -1) then
			temp1 = exposcall("Write", -2, "Invalid credentials");
		endif;
		if (temp == -2) then
			temp1 = exposcall("Write", -2, "Permission denied");
		endif;
	endwhile;
	return 0;
end
}


