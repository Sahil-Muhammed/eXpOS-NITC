int main()
{
    decl
        int fd1, fd2, temp;
        string fileName1, fileName2, word;
    enddecl
    begin
        temp = exposcall("Read", -1, fileName1);
        temp = exposcall("Read", -1, fileName2);

        fd1 = exposcall("Open", fileName1);
        if(fd1 < 0) then
            write("Error opening file");
        else
            temp = exposcall("Create", fileName2, 0);
            if(temp < 0) then
                write("Error creating file");
            else
                fd2 = exposcall("Open", fileName2);
                if(fd2 < 0) then
                    write("Error Opening file");
                else
                    while(1 == 1) do
                        temp = exposcall("Read", fd1, word);
                        if(temp < 0) then
                            break;
                        endif;

                        temp = exposcall("Write", fd2, word);
                        if(temp < 0) then
                            write("Error writing to file");
                            break;
                        endif;
                    endwhile;

                    temp = exposcall("Close", fd1);
                    temp = exposcall("Close", fd2);
                endif;
            endif;
        endif;

        return 0;
    end
}
