int main() {
    decl
        int temp, fd;
        string w1, fileName, word;
    enddecl
    begin
        w1 = "Enter File";
        temp = exposcall("Write", -2, w1);
        temp = exposcall("Read", -1, fileName);

        fd = exposcall("Open", fileName);
        if(fd != 0) then
            temp = exposcall("Write", -2, fd);
        else
            while(1 == 1) do
                temp = exposcall("Read", fd, word);
                if(temp == -2) then
                    break;
                endif;

                temp = exposcall("Write", -2, word);
            endwhile;
        endif;

        return 0;
    end
}