int main() {
    decl
        int temp, fd, loop;
        string fileName, permission, word;
    enddecl
    begin
        read(fileName);
        read(permission);

        temp = exposcall("Create", fileName, permission);
        fd = exposcall("Open", fileName);

        loop = 1;
        while(loop <= 1100) do
            temp = exposcall("Write", fd, loop);
            loop = loop + 1;
        endwhile;
        
        temp = exposcall("Seek", fd, -1);
        
        loop = 1;
        while(loop <= 1100) do
            temp = exposcall("Read", fd, word);
            write(word);

            temp = exposcall("Seek", fd, -2);
            loop = loop + 1;
        endwhile;

        temp = exposcall("Close", fd);

        return 0;
    end
}
