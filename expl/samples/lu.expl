int main()
{
    decl
        int loop, temp;
        int word;
    enddecl
    begin
        loop = 0;
        while(loop < 16) do
            word = exposcall("Getuname", loop);
            if(word != -1) then
                temp = exposcall("Write", -2, word);
            endif;
            
            loop = loop + 1;
        endwhile;

        return 0;
    end
}
