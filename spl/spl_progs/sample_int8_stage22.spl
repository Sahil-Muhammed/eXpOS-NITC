[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 9] = 8;

alias retValAddr R7;
retValAddr = [PTBR + 2 * (SP - 1) / 512] * 512 + ((SP - 1) % 512);

alias parentProcessTable R6;
parentProcessTable = PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16);


// switch to kernel stack
[parentProcessTable + 13] = SP;
SP = [parentProcessTable + 11] * 512 - 1;

alias pte R10;

R1 = GET_PCB_ENTRY;
call MOD_1;
pte = R0;

alias childPT R14;
childPT = PROCESS_TABLE + (pte * 16);


if (pte == -1) then
	[parentProcessTable + 9] = 0;
	SP = [parentProcessTable + 13];
	ireturn;
endif;

if ([PTBR + (2*2)] == -1) then
	// allocate 2 pages for heap since it wasn't allocated earlier
	R1 = GET_FREE_PAGE;
	R2 = [SYSTEM_STATUS_TABLE + 1];
	call MOD_2;
	[PTBR + 4] = R0;
	[PTBR + 5] = "0110";
	
	R1 = GET_FREE_PAGE;
	R2 = [SYSTEM_STATUS_TABLE + 1];
	call MOD_2;
	[PTBR + 6] = R0;
	[PTBR + 7] = "0110";
endif;

R1 = GET_FREE_PAGE;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_2;
[childPT + 11] = R0;

R1 = GET_FREE_PAGE;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_2;
[PAGE_TABLE_BASE + (pte*20) + 16] = R0;
[PAGE_TABLE_BASE + (pte*20) + 17] = [PTBR + 17];

R1 = GET_FREE_PAGE;
R2 = [SYSTEM_STATUS_TABLE + 1];
call MOD_2;
[PAGE_TABLE_BASE + (pte*20) + 18] = R0;
[PAGE_TABLE_BASE + (pte*20) + 19] = [PTBR + 19];

// copy parent's process table entry fields

[childPT + 3] = [parentProcessTable + 3];
[childPT + 4] = CREATED;
[childPT + 5] = [parentProcessTable + 5];
[childPT + 6] = [parentProcessTable + 6];
[childPT + 7] = [parentProcessTable + 7];
[childPT + 9] = 0;
[childPT + 10] = [parentProcessTable + 10];
[childPT + 13] = [parentProcessTable + 13];

[childPT + 2] = [SYSTEM_STATUS_TABLE + 1];
[childPT + 0] = 0;
[childPT + 1] = pte;
[childPT + 12] = 0;

// copy disk map table

alias i R11;
i = 0;
while (i < 10) do
	[DISK_MAP_TABLE + (pte*10) + i] = [DISK_MAP_TABLE + ([SYSTEM_STATUS_TABLE + 1]*10 + i)];
	i = i + 1;
endwhile;


i = 0;
alias UAreaPageChild R12;
UAreaPageChild = [PROCESS_TABLE + (pte*16) + 11];
alias UAreaPageParent R13;
UAreaPageParent = [parentProcessTable + 11];

alias resTableAddrChild R9;
resTableAddrChild = UAreaPageChild * 512 + RESOURCE_TABLE_OFFSET;
alias resTableAddrParent R8;
resTableAddrParent = UAreaPageParent * 512 + RESOURCE_TABLE_OFFSET;

while (i < 8) do
	if ([resTableAddrParent + (2*i)] == SEMAPHORE) then
		alias processCountAddr R5;
		processCountAddr = SEMAPHORE_TABLE + ([resTableAddrParent + (2*i) + 1] * 4) + 1;
		[processCountAddr] = [processCountAddr] + 1;
	endif;
	if ([resTableAddrParent + (2*i)] == FILE) then
		[OPEN_FILE_TABLE + [resTableAddrParent + (2*i) + 1]] = [OPEN_FILE_TABLE + [resTableAddrParent + (2*i) + 1]] + 1;
	endif;
	[resTableAddrChild + (2*i)] = [resTableAddrParent + (2*i)];
	[resTableAddrChild + (2*i) + 1] = [resTableAddrParent + (2*i) + 1];
	i = i + 1;
endwhile;

i = 0;
while (i < 8) do
	[PAGE_TABLE_BASE + (pte * 20) + (2*i)] = [PTBR + (2*i)];
	[PAGE_TABLE_BASE + (pte * 20) + (2*i) + 1] = [PTBR + (2 * i) + 1];
	if (i > 1 && [PTBR + (2 * i)] != -1) then
		[MEMORY_FREE_LIST + [PTBR + (2*i)]] = [MEMORY_FREE_LIST + [PTBR + (2*i)]] + 1;
	endif;
	i = i + 1;
endwhile;

// set stack pages in page table

// done earlier

i = 0;
alias ChildStack R4;
ChildStack = [PAGE_TABLE_BASE + (pte * 20) + 16] * 512;
alias ParentStack R3;
ParentStack = [PTBR + 16] * 512;
while (i < PAGE_SIZE) do
	[ChildStack + i] = [ParentStack + i];
	i = i + 1;
endwhile; 

i = 0;
ChildStack = [PAGE_TABLE_BASE + (pte * 20) + 18] * 512;
ParentStack = [PTBR + 18] * 512;
while (i < PAGE_SIZE) do
        [ChildStack + i] = [ParentStack + i];
        i = i + 1;
endwhile;

SP = [childPT + 11] * 512 - 1;
multipush(BP);

[retValAddr] = pte;

// re-use i to store logical address of return address in stack (child)
// MUST use child's own page table (PAGE_TABLE_BASE+pte*20), NOT PTBR (parent's),
// because child has NEW physical stack pages — PTBR would write to parent's stack
// and overwrite the parent's return value (pte) we just set above.
i = [childPT + 13];
[[PAGE_TABLE_BASE + (pte*20) + 2 * ((i - 1) / 512)] * 512 + ((i - 1) % 512)] = 0;

// state of child already set to CREATED at start of fork

// set mode flag of parent process to 0

[parentProcessTable + 9] = 0;

// switch stack to user stack and return to parent process

SP = [parentProcessTable + 13];
ireturn;
