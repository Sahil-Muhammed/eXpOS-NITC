// Loop: load exception handler, timer, disk/console int, INT 4-17
// Pattern: page=2N+2, block=2N+15 for N=0..17
alias pg R0;
alias blk R1;
pg = 2;
blk = 15;
while (pg <= 36) do
	loadi(pg, blk);
	loadi(pg + 1, blk + 1);
	pg = pg + 2;
	blk = blk + 2;
endwhile;

// Loop: load MOD 0 through MOD 6
// Pattern: page=2N+40, block=2N+53 for N=0..6
pg = 40;
blk = 53;
while (pg <= 52) do
	loadi(pg, blk);
	loadi(pg + 1, blk + 1);
	pg = pg + 2;
	blk = blk + 2;
endwhile;

// Individual loads
loadi(59, 3);
loadi(60, 4);
loadi(61, 2);

[TERMINAL_STATUS_TABLE] = 0;
[DISK_STATUS_TABLE] = 0;

// init process (PID 1)
PTBR = PAGE_TABLE_BASE + 20;
PTLR = 10;

[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";
[PTBR+16] = 66;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

[PROCESS_TABLE + 17] = 1;
[PROCESS_TABLE + 19] = 1;
[PROCESS_TABLE + 27] = 77;
[PROCESS_TABLE + 29] = 4096;
[PROCESS_TABLE + 28] = 0;
[PROCESS_TABLE + 30] = PAGE_TABLE_BASE+20;
[PROCESS_TABLE + 31] = 10;
[PROCESS_TABLE + 20] = CREATED;

[33792] = [33281];

// shell process (PID 2)
PTBR = PAGE_TABLE_BASE + 40;
PTLR = 10;

[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";
[PTBR+8] = 67;
[PTBR+9] = "0100";
[PTBR+10] = 68;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";
[PTBR+16] = 78;
[PTBR+17] = "0110";
[PTBR+18] = 79;
[PTBR+19] = "0110";

[PROCESS_TABLE + 33] = 2;
[PROCESS_TABLE + 34] = 1;
[PROCESS_TABLE + 35] = 1;
[PROCESS_TABLE + 43] = 80;
[PROCESS_TABLE + 45] = 4096;
[PROCESS_TABLE + 44] = 0;
[PROCESS_TABLE + 46] = PAGE_TABLE_BASE+40;
[PROCESS_TABLE + 47] = 10;
[PROCESS_TABLE + 36] = TERMINATED;

[39936] = [34305];

// disk map table for shell
[DISK_MAP_TABLE + 20] = -1;
[DISK_MAP_TABLE + 21] = -1;
[DISK_MAP_TABLE + 22] = -1;
[DISK_MAP_TABLE + 23] = -1;
[DISK_MAP_TABLE + 24] = 9;
[DISK_MAP_TABLE + 25] = 10;
[DISK_MAP_TABLE + 26] = -1;
[DISK_MAP_TABLE + 27] = -1;
[DISK_MAP_TABLE + 28] = -1;
[DISK_MAP_TABLE + 29] = -1;

// buffer table
[BUFFER_TABLE] = -1;
[BUFFER_TABLE + 1] = 0;
[BUFFER_TABLE + 2] = -1;
[BUFFER_TABLE + 4] = -1;
[BUFFER_TABLE + 5] = 0;
[BUFFER_TABLE + 6] = -1;
[BUFFER_TABLE + 8] = -1;
[BUFFER_TABLE + 9] = 0;
[BUFFER_TABLE + 10] = -1;
[BUFFER_TABLE + 12] = -1;
[BUFFER_TABLE + 13] = 0;
[BUFFER_TABLE + 14] = -1;

alias i R0;

// per-process resource table for init
alias base R1;
base = 40960 + RESOURCE_TABLE_OFFSET;
i = 0;
while (i < 16) do
	[base + i] = -1;
	i = i + 2;
endwhile;

// tick=0, swap_flag=0, and state=TERMINATED for all
i = 0;
while (i < 16) do
	[PROCESS_TABLE + (i * 16)] = 0;
	[PROCESS_TABLE + (i * 16) + 6] = 0;
	if (i >= 2) then
		[PROCESS_TABLE + (i * 16) + 4] = TERMINATED;
	endif;
	i = i + 1;
endwhile;

// memory free list
i = 0;
while (i < 83) do
	[MEMORY_FREE_LIST + i] = 1;
	i = i + 1;
endwhile;
while (i < 128) do
	[MEMORY_FREE_LIST + i] = 0;
	i = i + 1;
endwhile;

[SYSTEM_STATUS_TABLE + 2] = 45;
[SYSTEM_STATUS_TABLE + 3] = 0;
[SYSTEM_STATUS_TABLE + 4] = 0;
[SYSTEM_STATUS_TABLE + 5] = 0;

i = 0;
while (i < MAX_SEM_COUNT) do
	[SEMAPHORE_TABLE + (i * 4)] = -1;
	[SEMAPHORE_TABLE + (i * 4) + 1] = 0;
	i = i + 1;
endwhile;

i = 0;
while (i < MAX_FILE_NUM) do
	[FILE_STATUS_TABLE + (i * 4)] = -1;
	[FILE_STATUS_TABLE + (i * 4) + 1] = -1;
	i = i + 1;
endwhile;

i = 0;
while (i < MAX_OPENFILE_NUM) do
	[OPEN_FILE_TABLE + (i * 4)] = -1;
	[OPEN_FILE_TABLE + (i * 4) + 1] = 0;
	i = i + 1;
endwhile;

return;
