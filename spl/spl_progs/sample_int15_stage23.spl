alias procTable R0;
procTable = PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16);

alias retVal R1;
retVal = [PTBR + 2 * (SP - 1) / 512] * 512 + ((SP - 1) % 512);

[procTable + 13] = SP;
SP = [procTable + 11] * 512 - 1;

[procTable + 9] = INT_SHUTDOWN;

alias PID R2;
PID = [PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 1];

if (PID != 1 || [procTable + 3] != 1) then
	[retVal] = -1;
	[procTable + 9] = 0;
	SP = [procTable + 13];
	ireturn;
endif;

multipush(R0, R1, R2);

R1 = DISK_STORE;
R2 = PID;
R3 = 59;
R4 = 3;

call MOD_4;

R1 = DISK_STORE;
R2 = PID;
R3 = 60;
R4 = 4;

call MOD_4;

R1 = DISK_STORE;
R2 = PID;
R3 = 61;
R4 = 2;

call MOD_4;

R1 = DISK_STORE;
R2 = PID;
R3 = 62;
R4 = 5;

call MOD_4;

multipop(R0, R1, R2);

halt;
