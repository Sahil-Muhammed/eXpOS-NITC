[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 7;
alias userSP R0;
userSP=SP;

// store value of SP in UPTR field of process table

[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;

SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

alias fileDesc R1;
fileDesc = [[PTBR + 2 * ((userSP - 4)/512)] * 512 + ((userSP - 4) % 512)];

alias physicalRetAddr R2;
physicalRetAddr = ([PTBR + 2 * ((userSP - 1)/512)] * 512) + ((userSP - 1)%512);
if (fileDesc != -1) then
	if (fileDesc < 0 || fileDesc > 7) then
	        [physicalRetAddr] = -1;
		[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 9] = 0;
		ireturn;
	endif;

	// locate per-process resource table

	alias PID R3;
	PID = [SYSTEM_STATUS_TABLE + 1];
	
	alias UAreaPage R4;
	UAreaPage = [PROCESS_TABLE + (PID * 16) + 11];

	alias resTable R5;
	resTable = UAreaPage * 512 + RESOURCE_TABLE_OFFSET;
	
	if ([resTable + (2 * fileDesc)] != FILE) then
		[physicalRetAddr] = -1;
		[PROCESS_TABLE + (PID * 16) + 9] = 0;
		ireturn;
	endif;

	alias OFTindex R6;
	OFTindex = [resTable + (2 * fileDesc) + 1];

	alias inodeIndex R7;
	inodeIndex = [OPEN_FILE_TABLE + (4 * OFTindex)];

	// acquire lock on inode

	multipush(R0, R1, R2, R3, R4, R5, R6, R7);
	
	R1 = ACQUIRE_INODE;	
	R2 = inodeIndex;
	// R3 already holds PID

	call RESOURCE_MANAGER;

	// store return value in R10
	R10 = R0;
	multipop(R0, R1, R2, R3, R4, R5, R6, R7);
	
	if (R10 == -1) then
		[physicalRetAddr] = -1;
		[PROCESS_TABLE + (PID * 16) + 9] = 0;
		ireturn;
	endif;

	alias lseek R8;
	lseek = [OPEN_FILE_TABLE + (OFTindex * 4) + 2];

	alias MemBuffer R9;
	MemBuffer = [[PTBR + 2 * ((userSP - 3)/512)] * 512 + ((userSP - 3)%512)];
	// Convert logical address to physical address for kernel mode access
	MemBuffer = [PTBR + 2 * (MemBuffer / 512)] * 512 + (MemBuffer % 512);

	if (inodeIndex == INODE_ROOT) then
		if (lseek == 480) then
			// if lseek value is size of root file, then release inode
			// and return -2

			multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9);

			R1 = RELEASE_INODE;
			R2 = inodeIndex;
			// R3 already holds PID
			
			call RESOURCE_MANAGER;
			
			multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9);
			
			[physicalRetAddr] = -2;
			[PROCESS_TABLE + (PID * 16) + 9] = 0;
			ireturn;
		endif;
	
		[MemBuffer] = [ROOT_FILE + lseek];

                // increment the lseek field in the open file table

                alias OFTentry R10;
                OFTentry = OPEN_FILE_TABLE + (OFTindex * 4);
                [OFTentry + 2] = [OFTentry + 2] + 1;
				breakpoint;	
	else
		if (lseek == [INODE_TABLE + (inodeIndex * 16) + 2]) then
			multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9);

                        R1 = RELEASE_INODE;
                        R2 = inodeIndex;
                        // R3 already holds PID

                        call RESOURCE_MANAGER;

                        multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9);

                        [physicalRetAddr] = -2;
                        [PROCESS_TABLE + (PID * 16) + 9] = 0;
                        ireturn;
		endif;

		alias blockIndex R10;
		blockIndex = lseek / 512;
		
		alias diskBlock R11;
		diskBlock = [INODE_TABLE + (inodeIndex * 16) + 8 + blockIndex];

		alias offset R12;
		offset = lseek % 512;
		
		multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12);

		R1 = BUFFERED_READ;
		R2 = diskBlock;
		R3 = offset;
		R4 = MemBuffer;

		call FILE_MANAGER;
		
		multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12);

		alias OFTentry R13;
		OFTentry = OPEN_FILE_TABLE + (OFTindex * 4);
		[OFTentry + 2] = [OFTentry + 2] + 1; 
	endif;

	multipush(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12);
	
	R1 = RELEASE_INODE;
	R2 = inodeIndex;
	// R3 already holds PID
	
	call RESOURCE_MANAGER;

	multipop(R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12);
	[physicalRetAddr] = 0;
else
	alias wordAddr R3;
	wordAddr = [[PTBR + 2 * ((userSP - 3)/512)] * 512 + ((userSP - 3)%512)];
	multipush(R0, R1, R2, R3);

	R1 = TERMINAL_READ;
	R2 = [SYSTEM_STATUS_TABLE + 1];
	// R3 already stores wordAddr

	call MOD_4;

	multipop(R0, R1, R2, R3);

        [physicalRetAddr] = 0;
endif;

// change mode flag to 0
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13];
ireturn;

