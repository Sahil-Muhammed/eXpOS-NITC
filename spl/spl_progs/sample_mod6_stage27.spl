alias function R1;
alias PID R2;
alias i R3;

if (function == SWAP_OUT) then
	i = 3;
	PID = -1;
	while (i < 16) do
		if (([PROCESS_TABLE + (i*16) + 4] == WAIT_PROCESS || [PROCESS_TABLE + (i*16) + 4] == WAIT_SEMAPHORE) && [PROCESS_TABLE + (i*16) + 6] != 1) then
			PID = i;
			break;
		endif;
		i = i + 1;
	endwhile;

	if (PID == -1) then
		alias maxTick R4;
		maxTick = -1;
		i = 3;
		while (i < 16) do
			if ([PROCESS_TABLE + (i*16) + 4] == READY && [PROCESS_TABLE + (i*16) + 6] != 1) then
				if ([PROCESS_TABLE + (i*16)] > maxTick) then
					maxTick = [PROCESS_TABLE + (i*16)];
					PID = i;
				endif;
			endif;
			i = i + 1;
		endwhile;
	endif;

	if (PID == -1) then
		[SYSTEM_STATUS_TABLE + 5] = 0;
		return;
	endif;

	[PROCESS_TABLE + (PID*16)] = 0;
	alias page_table R6;
	page_table = [PROCESS_TABLE + (PID*16) + 14];

	i = 2;
	while (i < 10) do
		if ([page_table + (2*i)] != -1 && [page_table + (2*i) + 1] != "0000") then
			if (i >= 4 && i <= 7) then
				multipush(R1, R2, R3, R6);
				R1 = RELEASE_PAGE;
				R2 = [page_table + (2*i)];
				call MEMORY_MANAGER;
				multipop(R1, R2, R3, R6);
				[page_table + (2*i)] = -1;
				[page_table + (2*i) + 1] = "0000";
			else
				alias skip R5;
				skip = 0;
				if (i <= 3) then
					R4 = 0;
					while (R4 < 16) do
						if (R4 != PID) then
							if ([PAGE_TABLE_BASE + (R4*20) + 4] == [page_table + (2*i)] && [PAGE_TABLE_BASE + (R4*20) + 5] != "0000") then
								skip = 1;
								break;
							endif;
							if ([PAGE_TABLE_BASE + (R4*20) + 6] == [page_table + (2*i)] && [PAGE_TABLE_BASE + (R4*20) + 7] != "0000") then
								skip = 1;
								break;
							endif;
						endif;
						R4 = R4 + 1;
					endwhile;
				endif;
				if (skip != 1) then
					multipush(R1, R2, R3, R6);
					R1 = GET_SWAP_BLOCK;
					call MEMORY_MANAGER;
					multipop(R1, R2, R3, R6);
					[DISK_MAP_TABLE + (PID*10) + i] = R0;
					multipush(R1, R0, R2, R3, R6);
					R1 = DISK_STORE;
					R4 = R0;
					R3 = [page_table + (2*i)];
					R2 = [SYSTEM_STATUS_TABLE + 1];
					call DEVICE_MANAGER;
					multipop(R1, R0, R2, R3, R6);
					multipush(R1, R2, R3, R6);
					R1 = RELEASE_PAGE;
					R2 = [page_table + (2*i)];
					call MEMORY_MANAGER;
					multipop(R1, R2, R3, R6);
					[page_table + (2*i)] = -1;
					[page_table + (2*i) + 1] = "0000";
				endif;
			endif;
		endif;
		i = i + 1;
	endwhile;

	[PROCESS_TABLE + (PID*16) + 6] = 1;
	[SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] + 1;
	[SYSTEM_STATUS_TABLE + 5] = 0;
	return;
endif;

if (function == SWAP_IN) then
	alias maxTick R4;
	maxTick = -1;
	PID = -1;
	i = 3;
	while (i < 16) do
		if ([PROCESS_TABLE + (i*16) + 4] == READY && [PROCESS_TABLE + (i*16) + 6] == 1) then
			if ([PROCESS_TABLE + (i*16)] > maxTick) then
				maxTick = [PROCESS_TABLE + (i*16)];
				PID = i;
			endif;
		endif;
		i = i + 1;
	endwhile;

	if (PID == -1) then
		[SYSTEM_STATUS_TABLE + 5] = 0;
		return;
	endif;

	[PROCESS_TABLE + (PID*16)] = 0;

	i = 2;
	while (i < 10) do
		if (i >= 4 && i <= 7) then
			i = i + 1;
			continue;
		endif;
		if ([DISK_MAP_TABLE + (PID*10) + i] != -1) then
			multipush(R1, R2, R3);
			R1 = GET_FREE_PAGE;
			call MEMORY_MANAGER;
			multipop(R1, R2, R3);
			alias page_table R5;
			page_table = [PROCESS_TABLE + (PID*16) + 14];
			[page_table + (2*i)] = R0;
			[page_table + (2*i) + 1] = "0110";
			multipush(R1, R0, R2, R3, R5);
			R1 = DISK_LOAD;
			R4 = [DISK_MAP_TABLE + (PID*10) + i];
			R2 = [SYSTEM_STATUS_TABLE + 1];
			R3 = R0;
			call DEVICE_MANAGER;
			multipop(R1, R0, R2, R3, R5);
			multipush(R1, R2, R3);
			R1 = RELEASE_BLOCK;
			R3 = PID;
			R2 = [DISK_MAP_TABLE + (PID*10) + i];
			call MEMORY_MANAGER;
			multipop(R1, R2, R3);
			[DISK_MAP_TABLE + (PID*10) + i] = -1;
		endif;
		i = i + 1;
	endwhile;

	[PROCESS_TABLE + (PID*16) + 6] = 0;
	[SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] - 1;
	[SYSTEM_STATUS_TABLE + 5] = 0;
endif;
return;
