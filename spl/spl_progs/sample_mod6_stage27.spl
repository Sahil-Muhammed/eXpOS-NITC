// choose a process to swap out (other than idle, login, or shell)
alias PID R2;
alias i R3;
alias function R1;

i = 3;


if (function == SWAP_OUT) then
	while (i < MAX_PROC_NUM) do
		if ([PROCESS_TABLE + (i * 16) + 4] == WAIT_PROCESS && [PROCESS_TABLE + (i * 16) + 6] != 1) then
			break;
		endif;
		i = i + 1;
	endwhile;

	if (i == MAX_PROC_NUM) then
		i = 3;
		while (i < MAX_PROC_NUM) do
			if ([PROCESS_TABLE + (i * 16) + 4] == WAIT_SEMAPHORE && [PROCESS_TABLE + (i * 16) + 6] != 1) then
				break;
			endif;
			i = i + 1;
		endwhile;

		if (i == MAX_PROC_NUM) then
		
			alias maxTick R4;
			maxTick = -1;

			i = 3;
			while (i < MAX_PROC_NUM) do
				if ([PROCESS_TABLE + (i * 16) + 4] != RUNNING || [PROCESS_TABLE + (i * 16) + 4] != TERMINATED || [PROCESS_TABLE + (i * 16) + 4] != ALLOCATED || [PROCESS_TABLE + (i * 16) + 6] != 1) then
					if (maxTick < [PROCESS_TABLE + (i * 16)]) then
						maxTick = [PROCESS_TABLE + (i * 16)];
					endif;
				endif;
				i = i + 1;
			endwhile;

			if (maxTick == -1) then
				[SYSTEM_STATUS_TABLE + 5] = 0;
				return;
			endif;
		endif;
	endif;


	[PROCESS_TABLE + (i * 16)] = 0;


	i = 4;
	while (i < 8) do
		if ([PTBR + (2 * i)] != -1) then
			multipush(R0, R1, R2, R3, R4);

			R1 = RELEASE_PAGE;
			R2 = [PTBR + (2 * i)];

			call MEMORY_MANAGER;

			multipop(R0, R1, R2, R3, R4);
		
			// invalidate code pages in page table

			[PTBR + (2 * i)] = -1;
			[PTBR + (2 * i) + 1] = "0000";

		endif;
		i = i + 1;
	endwhile;

	i = 2;
	alias j R5;
	j = 0;
	while (i < 4) do
		if ([PTBR + (2 * i)] == -1) then
			i = i + 1;
			continue;
		endif;

		while (j < MAX_PROC_NUM) do
			if ([PTBR + (2 * i)] == [PAGE_TABLE_BASE + (j * 20) + 8] || [PTBR + (2 * i)] == [PAGE_TABLE_BASE + (j * 20) + 10]) then
				break;
			endif;
			j = j + 1;
		endwhile;
		
		if (j == MAX_PROC_NUM) then
			// heap page is not shared

			multipush(R0, R1, R2, R3, R4, R5);

			R1 = GET_SWAP_BLOCK;
			
			call MEMORY_MANAGER;

			// store result in temp reg R10
			R10 = R0;

			multipop(R0, R1, R2, R3, R4, R5);

			[DISK_MAP_TABLE + (R2 * 10) + i] = R10;

			multipush(R0, R1, R2, R3, R4, R5);

			R1 = DISK_STORE;
			R2 = PID;
			R3 = [PTBR + (2 * i)];
			R4 = R10;

			call DEVICE_MANAGER;

			multipop(R0, R1, R2, R3, R4, R5);

			multipush(R0, R1, R2, R3, R4, R5);

			R1 = RELEASE_PAGE;
			R2 = [PTBR + (2 * i)];
		
			call MEMORY_MANAGER;

			multipop(R0, R1, R2, R3, R4, R5);

			[PTBR + (2 * i)] = -1;
			[PTBR + (2 * i) + 1] = "0000";
		endif;
		i = i + 1;
	endwhile;

	i = 8;

	while (i < 10) do
		multipush(R0, R1, R2, R3, R4, R5);

		R1 = GET_SWAP_BLOCK;

		call MEMORY_MANAGER;

		// store result in temp reg R10
		R10 = R0;

		multipop(R0, R1, R2, R3, R4, R5);

		[DISK_MAP_TABLE + (R2 * 10) + i] = R10;

		multipush(R0, R1, R2, R3, R4, R5);

		R1 = DISK_STORE;
		R2 = PID;
		R3 = [PTBR + (2 * i)];
		R4 = R10;

		call DEVICE_MANAGER;

		multipop(R0, R1, R2, R3, R4, R5);

		multipush(R0, R1, R2, R3, R4, R5);

		R1 = RELEASE_PAGE;
		R2 = [PTBR + (2 * i)];

		call MEMORY_MANAGER;

		multipop(R0, R1, R2, R3, R4, R5);

		[PTBR + (2 * i)] = -1;
		[PTBR + (2 * i) + 1] = "0000";
		i = i + 1;
	endwhile;

	[PROCESS_TABLE + (PID * 16) + 6] = 1;

	[SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] + 1;
	[SYSTEM_STATUS_TABLE + 5] = 0;
endif;

if (function == SWAP_IN) then
	// Loop through the Process Table and find the swapped process in the READY state with the highest TICK.
	// If there is no such process in the READY state, reset the PAGING_STATUS field to 0 and Return.

	alias highTick R4; 
	highTick = -1;

	alias highTickProc R5;
	highTickProc = -1;
	i = 4;
	while (i < MAX_PROC_NUM) do
		if ([PROCESS_TABLE + (i * 16) + 4] == READY && [PROCESS_TABLE + (i * 16) + 6] == 1) then
			if ([PROCESS_TABLE + (i * 16)] > highTick) then
				highTick = [PROCESS_TABLE + (i * 16)];
				highTickProc = i;
			endif;		
		endif;
		i = i + 1;
	endwhile;

	if (highTick == -1 || highTickProc == -1) then
		// reset paging status field and return

		[SYSTEM_STATUS_TABLE + 5] = 0;
		return;
	endif;

	// set tick field of selected process to 0

	[PROCESS_TABLE + (i * 16)] = 0;
	
	alias j R6;
	j = 2;
	while (j < 10) do
		if (j > 3 || j < 8) then
			j = j + 1;
			continue;
		endif;
		if ([DISK_MAP_TABLE + (R2 * 10) + j] != -1) then
			multipush(R0, R1, R2, R3, R4, R5, R6);

			R1 = GET_FREE_PAGE;

			call MEMORY_MANAGER;
			
			// store result in temp reg R10
			R10 = R0;

			multipop(R0, R1, R2, R3, R4, R5, R6);

			multipush(R0, R1, R2, R3, R4, R5, R6);

			R1 = DISK_LOAD;
			R2 = R10;
			R3 = [DISK_MAP_TABLE + (R2 * 10) + j];
	
			call DEVICE_MANAGER; 

			multipop(R0, R1, R2, R3, R4, R5, R6);

			multipush(R0, R1, R2, R3, R4, R5, R6);
			
			R1 = RELEASE_BLOCK;
			R3 = R2;
			R2 = [DISK_MAP_TABLE + (R2 * 10) + j];

			multipop(R0, R1, R2, R3, R4, R5, R6);

			[PTBR + (2 * j)] = R10;
			[PTBR + (2 * j) + 1] = "0110";

			[DISK_MAP_TABLE + (R2 * 10) + j] = -1;
		endif;
		j = j + 1;
	endwhile;

	[PROCESS_TABLE + (R2 * 16) + 6] = 0;

	[SYSTEM_STATUS_TABLE + 4] = [SYSTEM_STATUS_TABLE + 4] - 1;
	[SYSTEM_STATUS_TABLE + 5] = 0;
endif;
return;
