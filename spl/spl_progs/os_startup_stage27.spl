//load idle code to memory
loadi(69, 11);
// load module 7 into memory
loadi(54, 67);
loadi(55, 68);
// load root file
loadi(62, 5);
// load fork (INT 8)
loadi(18, 31);
loadi(19, 32);
// load Process Sync (INT 11)
loadi(24, 37);
loadi(25, 38);
// load shutdown interrupt (INT 15)
loadi(32, 45);
loadi(33, 46);
// load semget, semrelease (INT 13)
loadi(28, 41);
loadi(29, 42);
// load semlock, semunlock (INT 14)
loadi(30, 43);
loadi(31, 44);
// load create, write file (INT 4)
loadi(10, 23);
loadi(11, 24);
// load seek, open, close (INT 5)
loadi(12, 25);
loadi(13, 26);
// load file manager (MOD 3)
loadi(46, 59);
loadi(47, 60);
// load shell
loadi(67, 9);
loadi(68, 10);
// load newusr, remusr (INT 16)
loadi(34, 47);
loadi(35, 48);
// load login (INT 17)
loadi(36, 49);
loadi(37, 50);
// load logout (INT 12)
loadi(26, 39);
loadi(27, 40);

SP = 82 * 512 - 1;

call BOOT_MODULE;

PTBR=PAGE_TABLE_BASE;  //as PID of idle process is 0
PTLR = 10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 70;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";


[PROCESS_TABLE + 11] = 76;
// Kernel stack pointer=0 for idle
[PROCESS_TABLE + 12] = 0;
[PROCESS_TABLE + 13] = 8*512;
//PID = 0 for idle
[PROCESS_TABLE + 1] = 0;

//PTBR and PTLR field in process table for idle
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE;
[PROCESS_TABLE + 15] = 10;

[PROCESS_TABLE + 4] = RUNNING;
[SYSTEM_STATUS_TABLE + 1] = 0;

[70 * 512] = [69*512 + 1];

SP = 8 * 512;

// swapper daemon

PTBR = PAGE_TABLE_BASE + (20 * 15);  //as PID of swapper daemon process is 15
PTLR = 10;

//Library
[PTBR+0] = -1;
[PTBR+1] = "0000";
[PTBR+2] = -1;
[PTBR+3] = "0000";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

[PROCESS_TABLE + (15 * 16)] = 0;
[PROCESS_TABLE + (15 * 16) + 11] = 82;
// Kernel stack pointer=0 for swapper daemon
[PROCESS_TABLE + (15 * 16) + 12] = 0;
[PROCESS_TABLE + (15 * 16) + 13] = 8*512;
//PID = 15 for swapper daemon
[PROCESS_TABLE + (15 * 16) + 1] = 15;
// userID for swapper daemon
[PROCESS_TABLE + (15 * 16) + 3] = 0;

//PTBR and PTLR field in process table for swapper daemon
[PROCESS_TABLE + (15 * 16) + 14] = PAGE_TABLE_BASE + (20 * 15);
[PROCESS_TABLE + (15 * 16) + 15] = 10;

[PROCESS_TABLE + (15 * 16) + 4] = CREATED;

[81*512] = [69*512 +1];

ireturn;
