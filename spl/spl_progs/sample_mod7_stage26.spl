loadi(65, 7);
loadi(22, 35);
loadi(23, 36);
loadi(2, 15);
loadi(3, 16);
loadi(63, 13);
loadi(64, 14);
// loading timer interrupt routine into memory
loadi(4, 17);
loadi(5, 18);
// load INT 7 routine to memory
loadi(16,29);
loadi(17,30);
// load resource manager module (MOD 0)
loadi(40, 53);
loadi(41, 54);
// load device manager module (MOD 4)
loadi(48, 61);
loadi(49, 62);
// load console interrupt handler
loadi(8, 21);
loadi(9, 22);
// load read routine (INT 6)
loadi(14, 27);
loadi(15, 28);
// load exec syscall (INT 9)
loadi(20, 33);
loadi(21, 34);
// load process manager module (MOD 1)
loadi(42, 55);
loadi(43, 56);
// load memory manager module (MOD 2)
loadi(44, 57);
loadi(45, 58);
// load inode table
loadi(59, 3);
loadi(60, 4);
// load disk interrupt routine
loadi(6, 19);
loadi(7, 20);
// load disk free list
loadi(61, 2);

[TERMINAL_STATUS_TABLE] = 0;
[DISK_STATUS_TABLE] = 0;

PTBR = PAGE_TABLE_BASE + 20;
PTLR = 10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 66;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

[PROCESS_TABLE + 17] = 1;
// UserID for init
[PROCESS_TABLE + 19] = 1;
// UArea Page number for init
[PROCESS_TABLE + 27] = 77;
// UPTR for init
[PROCESS_TABLE + 29] = 8*512;
// KPTR for init
[PROCESS_TABLE + 28] = 0;
// PTBR for init
[PROCESS_TABLE + 30] = PAGE_TABLE_BASE+20;
[PROCESS_TABLE + 31] = 10;

// State for init
[PROCESS_TABLE + 20] = CREATED;

[66*512] = [65 * 512 + 1];

// shell

PTBR = PAGE_TABLE_BASE + 40;
PTLR = 10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 67;
[PTBR+9] = "0100";
[PTBR+10] = 68;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 78;
[PTBR+17] = "0110";
[PTBR+18] = 79;
[PTBR+19] = "0110";

// PID for shell
[PROCESS_TABLE + (16 * 2) + 1] = 2;
// PPID for shell
[PROCESS_TABLE + (16 * 2) + 2] = 1;
// UserID for shell
[PROCESS_TABLE + (16 * 2) + 3] = 1;
// UArea Page number for shell
[PROCESS_TABLE + (16 * 2) + 11] = 80;
// UPTR for shell
[PROCESS_TABLE + (16 * 2) + 13] = 8*512;
// KPTR for shell
[PROCESS_TABLE + (16 * 2) + 12] = 0;
// PTBR for shell
[PROCESS_TABLE + (16 * 2) + 14] = PAGE_TABLE_BASE+40;
[PROCESS_TABLE + (16 * 2) + 15] = 10;

// State for shell
[PROCESS_TABLE + (16 * 2) + 4] = TERMINATED;

[78*512] = [67 * 512 + 1];


// initialize disk map table for shell

alias i R0;
i = 0;

while (i < 10) do
	if (i == 4 || i == 5) then
		i = i + 1;
		continue;
	endif;
	[DISK_MAP_TABLE + (2 * 10) + i] = -1;
	i = i + 1;
endwhile;

[DISK_MAP_TABLE + (2 * 10) + 4] = 67;
[DISK_MAP_TABLE + (2 * 10) + 5] = 68; 

// initialize per-process resource table for init

i = 0;
while (i < 8) do
	[80 * 512 + RESOURCE_TABLE_OFFSET + (2*i)] = -1;
	i = i + 1;
endwhile;

// load scheduler module into memory
loadi(50,63);
loadi(51,64);
i = 2;
while (i < MAX_PROC_NUM) do
	[PROCESS_TABLE + i*16 + 4] = TERMINATED;
	i = i + 1;
endwhile;

// initialize memory free list

i = 0;

while (i < 128) do
	if (i < 81) then
		[MEMORY_FREE_LIST + i] = 1;
	else
		[MEMORY_FREE_LIST + i] = 0;
	endif;
	i = i + 1;
endwhile; 

[SYSTEM_STATUS_TABLE + 2] = 47;
[SYSTEM_STATUS_TABLE + 3] = 0;

// initialize global semaphore table

i = 0;

while (i < MAX_SEM_COUNT) do
	[SEMAPHORE_TABLE + (i * 4)] = -1;
	[SEMAPHORE_TABLE + (i * 4) + 1] = 0;
	i = i + 1;
endwhile;

// initialize file status table

i = 0;
while (i < MAX_FILE_NUM) do
	[FILE_STATUS_TABLE + (i * 4)] = -1;
	[FILE_STATUS_TABLE + (i * 4) + 1] = -1;	
	i = i + 1;
endwhile;

// initialize buffer table

i = 0;
while (i < MAX_BUFFER) do
	[BUFFER_TABLE + (i * 4)] = -1;
	[BUFFER_TABLE + (i * 4) + 1] = 0;
	[BUFFER_TABLE + (i * 4) + 2] = -1;
	i = i + 1;
endwhile;

// initialize open file table

i = 0;

while (i < MAX_OPENFILE_NUM) do
	[OPEN_FILE_TABLE + (i * 4)] = -1;
	[OPEN_FILE_TABLE + (i * 4) + 1] = 0;
	i = i + 1;
endwhile;

return;
